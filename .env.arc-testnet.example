# Arc testnet. Copy to .env.arc-testnet and fill in; used by ./deploy.sh arc-testnet <Script>

RPC_URL=
VERIFIER=blockscout
VERIFIER_URL=https://testnet.arcscan.app/api/
DEPLOYER_PRIVATE_KEY=

# --- DeployYieldReceiver.s.sol ---
CRE_FORWARDER_ADDRESS=

# --- SetWorkflowId.s.sol ---
WORKFLOW_ID=

# --- DeployLendingVault.s.sol (required) ---
# EURC address
COLLATERAL_TOKEN_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
SUN_TOKEN_ADDRESS=
BORROWER_ADDRESS=
TOKEN_URI=
YIELD_RECEIVER_ADDRESS=
STATION_ID=
# EURC minor units, 6 decimals (10000000000 = €10,000)
PRINCIPAL=

# --- DeployLendingVault.s.sol (optional, defaults shown) ---
# Defaults to the deployer address
# ACTIVATOR_ADDRESS=
# FUNDING_WINDOW=2592000 # 30 days
# TERM=157680000 # ~5 years
# ACTIVATION_WINDOW=15552000 # 180 days
# GRACE_WINDOW=2592000 # 30 days
# Max |delta| a single rebase may apply, relative to principal, in bps (1000 = 10%)
# MAX_REBASE_DELTA_RATIO=1000
# MAX_STALENESS=604800 # 7 days
