# Arc mainnet. Copy to .env.arc and fill in; used by ./deploy.sh arc <Script>

RPC_URL=
VERIFIER=blockscout
VERIFIER_URL=
DEPLOYER_PRIVATE_KEY=

# --- DeployEnergyPriceOracle.s.sol ---
# Address the price-publisher lambda signs with. May be left empty: the oracle then
# accepts nothing until setPublisher is called, which is the safe state to deploy into
# before the key exists. Rotatable afterwards.
PRICE_PUBLISHER_ADDRESS=
# Sanity bound on a published price, EUR/MWh x 1e6, applied to both signs. Catches a
# mis-parsed number, not a chosen one. Adjustable later, so err wide: too narrow stops
# accrual for every vault on the days it rejects.
# MAX_ABS_PRICE_MICRO_PER_MWH=2000000000 # EUR 2000/MWh

# --- DeployYieldAdapter.s.sol ---
# The oracle deployed above. Fixed at construction, so replacing it means replacing
# every adapter and therefore every vault.
PRICE_ORACLE_ADDRESS=
# Address the yield-publisher lambda signs with. Same empty-is-inert rule as above.
YIELD_PUBLISHER_ADDRESS=

# --- DeployLendingVault.s.sol (required) ---
# EURC address
COLLATERAL_TOKEN_ADDRESS=
SUN_TOKEN_ADDRESS=
BORROWER_ADDRESS=
TOKEN_URI=
YIELD_ADAPTER_ADDRESS=
STATION_ID=
# Most the installation can physically produce in one reporting period, kWh x 1e3.
# This is what bounds a wrong production reading, so use the real ceiling plus a little
# headroom. Frozen at registration.
MAX_PERIOD_MILLI_KWH=
# EURC minor units, 6 decimals (10000000000 = €10,000)
PRINCIPAL=

# --- DeployLendingVault.s.sol (optional, defaults shown) ---
# Market this installation settles in, as the price oracle keys it
# STATION_COUNTRY=BG
# Defaults to the deployer address
# ACTIVATOR_ADDRESS=
# FUNDING_WINDOW=2592000 # 30 days
# TERM=157680000 # ~5 years
# ACTIVATION_WINDOW=15552000 # 180 days
# GRACE_WINDOW=2592000 # 30 days
# Max |delta| a single rebase may apply, relative to principal, in bps (1000 = 10%)
# MAX_REBASE_DELTA_RATIO=1000
# MAX_STALENESS=604800 # 7 days
